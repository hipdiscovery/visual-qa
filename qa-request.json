{
  "requestId": "merch-official-previews-20261005",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-catalog",
  "deploymentProbes": [
    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "3b8c7e4b6518ae11dc63faebc911b6233f016a86"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 1600,
  "journeys": [
    {
      "name": "official-product-preview",
      "captureSelector": ".merch-detail-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-tee'] [data-open-product]", "label": "Open premium tee"},
        {"action": "click", "selector": "[data-detail-size='XL']", "label": "Choose XL"}
      ]
    },
    {
      "name": "product-bag",
      "captureSelector": ".merch-cart-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-hoodie'] [data-open-product]", "label": "Open hoodie"},
        {"action": "click", "selector": "[data-detail-size='L']", "label": "Choose L"},
        {"action": "click", "selector": "[data-checkout-button]", "label": "Add to bag"}
      ]
    },
    {
      "name": "responsive-filters",
      "captureSelector": ".merch-catalog",
      "steps": [
        {"action": "click", "selector": "[data-category-filter='Hoodies']", "label": "Show hoodies"},
        {"action": "click", "selector": "[data-fit-filter='Women']", "label": "Show women's hoodies"},
        {"action": "click", "selector": "[data-reset-filters]", "label": "Reset filters"}
      ]
    }
  ]
}
