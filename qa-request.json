{
  "requestId": "merch-22-overview-20261001",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-catalog",
  "deploymentProbes": [
    {
      "path": "/css/pages/merch.css",
      "gitBlobSha": "582ca4461a157603fb92c2b0e80682070d0d7e51"
    },
    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "0ea8823e059687e7ea17bd35fc49ee119dabf11c"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 500,
  "journeys": [
    {
      "name": "category-filters",
      "steps": [
        {
          "action": "click",
          "selector": "[data-category=\"Tees\"]",
          "label": "Tees filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"Hoodies\"]",
          "label": "Hoodies filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"Sweatshirts\"]",
          "label": "Sweatshirts filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"Layers\"]",
          "label": "Layers filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"Bottoms\"]",
          "label": "Bottoms filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"Hats\"]",
          "label": "Hats filter"
        },
        {
          "action": "click",
          "selector": "[data-category=\"All\"]",
          "label": "All products filter"
        }
      ]
    },
    {
      "name": "shared-states",
      "steps": [
        {
          "action": "hover",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-open-product]",
          "label": "Product image hover"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-open-product]",
          "label": "Product image focus"
        },
        {
          "action": "hover",
          "selector": "[data-product-id=\"classic-unisex-tee\"] .merch-customize-btn",
          "label": "Customize hover"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] .merch-customize-btn",
          "label": "Customize focus"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-quick-color=\"navy\"]",
          "label": "Color focus"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-quick-wordmark=\"blanka\"]",
          "label": "Design focus"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-quick-print=\"white\"]",
          "label": "Print focus"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-quick-size]",
          "label": "Size focus"
        }
      ]
    },
    {
      "name": "generated-image-error",
      "steps": [
        {
          "action": "dispatch",
          "selector": "[data-product-id=\"classic-unisex-tee\"] [data-card-garment]",
          "event": "error",
          "label": "Generated mockup error state"
        }
      ]
    },
    {
      "name": "supplier-image-error",
      "steps": [
        {
          "action": "dispatch",
          "selector": "[data-product-id=\"contrast-hoodie\"] [data-card-garment]",
          "event": "error",
          "label": "Supplier photo error state"
        }
      ]
    }
  ]
}
