{
  "requestId": "merch-launch-ready-final-r2-20261002",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-catalog",
  "deploymentProbes": [
    {
      "path": "/css/pages/merch.css",
      "gitBlobSha": "59ea656e0ef8b11f21e314a24a0f639cb6724d32"
    },
    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "46dc69f4bdacfed46171c0ae6928f028dc8ed8c5"
    }
  ],
  "viewports": [
    "desktop-owner",
    "tablet",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 500,
  "journeys": [
    {
      "name": "launch-state",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"mens-premium-tee\"] [data-open-product]",
          "label": "Open remote product"
        },
        {
          "action": "hover",
          "selector": "[data-checkout-status]",
          "label": "Checkout pending status"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close remote product"
        }
      ]
    },
    {
      "name": "contrast-color-controls",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"contrast-hoodie\"] [data-quick-color=\"400\"]",
          "label": "Black contrast hoodie"
        },
        {
          "action": "click",
          "selector": "[data-product-id=\"contrast-hoodie\"] [data-open-product]",
          "label": "Open contrast hoodie"
        },
        {
          "action": "click",
          "selector": "[data-detail-color=\"341\"]",
          "label": "Navy contrast hoodie"
        },
        {
          "action": "click",
          "selector": "[data-detail-view=\"back\"]",
          "label": "Back view"
        },
        {
          "action": "click",
          "selector": "[data-detail-view=\"front\"]",
          "label": "Front view"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close contrast hoodie"
        }
      ]
    },
    {
      "name": "fit-filters-smoke",
      "steps": [
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Men\"]",
          "label": "Men filter"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Women\"]",
          "label": "Women filter"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Unisex\"]",
          "label": "Unisex filter"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"All\"]",
          "label": "All fits"
        }
      ]
    }
  ]
}
