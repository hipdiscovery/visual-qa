{
  "requestId": "merch-catalog-polish-regression-20261001",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-card",
  "deploymentProbes": [
    {
      "path": "/css/pages/merch.css",
      "gitBlobSha": "fe6e0deae08f3f1a0c589ae752dea3f299cdb00c"
    },
    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "3fd4aa39a6cffc6e0ab9a0db7d34ecd1f17d091f"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 450,
  "journeys": [
    {
      "name": "card-polish",
      "steps": [
        {
          "action": "click",
          "selector": "[data-quick-color=\"400\"]",
          "label": "Black garment"
        },
        {
          "action": "click",
          "selector": "[data-quick-wordmark=\"blanka\"]",
          "label": "Blanka design"
        },
        {
          "action": "click",
          "selector": "[data-quick-print=\"white\"]",
          "label": "White print"
        },
        {
          "action": "select",
          "selector": "[data-quick-size]",
          "value": "2XL",
          "label": "2XL inline size"
        }
      ]
    },
    {
      "name": "dialog-polish",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"contrast-hoodie\"] [data-open-product]",
          "label": "Open centered details"
        },
        {
          "action": "click",
          "selector": "[data-detail-color=\"341\"]",
          "label": "Navy detail color"
        },
        {
          "action": "click",
          "selector": "[data-detail-view=\"back\"]",
          "label": "Back detail view"
        },
        {
          "action": "click",
          "selector": "[data-detail-size=\"2XL\"]",
          "label": "Detail size 2XL"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close details"
        }
      ]
    }
  ]
}
