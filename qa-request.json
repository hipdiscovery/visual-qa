    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "dd6b26b71b55ee6258d06ef04b6499622814338f"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 650,
  "journeys": [
    {
      "name": "fit-filters",
      "steps": [
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Men\"]",
          "label": "Men fit"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Women\"]",
          "label": "Women fit"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Unisex\"]",
          "label": "Unisex fit"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"All\"]",
          "label": "All fits"
        }
      ]
    },
    {
      "name": "type-filters",
      "steps": [
        {
          "action": "click",
          "selector": "[data-category-filter=\"Tees\"]",
          "label": "Tees"
        },
        {
          "action": "click",
          "selector": "[data-category-filter=\"Hoodies\"]",
          "label": "Hoodies"
        },
        {
          "action": "click",
          "selector": "[data-category-filter=\"Sweatshirts\"]",
          "label": "Sweatshirts"
        },
        {
          "action": "click",
          "selector": "[data-category-filter=\"All\"]",
          "label": "All products"
        }
      ]
    },
    {
      "name": "combined-filter",
      "steps": [
        {
          "action": "click",
          "selector": "[data-fit-filter=\"Women\"]",
          "label": "Women"
        },
        {
          "action": "click",
          "selector": "[data-category-filter=\"Hoodies\"]",
          "label": "Women hoodies"
        },
        {
          "action": "click",
          "selector": "[data-fit-filter=\"All\"]",
          "label": "All fits hoodies"
        },
        {
          "action": "click",
          "selector": "[data-category-filter=\"All\"]",
          "label": "Reset"
        }
      ]
    },
    {
      "name": "fit-badge-focus",
      "steps": [
        {
          "action": "hover",
          "selector": "[data-product-id=\"womens-premium-hoodie\"] [data-open-product]",
          "label": "Women hoodie hover"
        },
        {
          "action": "focus",
          "selector": "[data-product-id=\"womens-premium-hoodie\"] [data-open-product]",
          "label": "Women hoodie focus"
        }
      ]
    }
  ]
