{
  "requestId": "merch-research-polish-20261006",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-catalog",
  "deploymentProbes": [
    {
      "path": "/css/pages/merch-commerce.css",
      "gitBlobSha": "c2a13e116888fe877f384c07f446838420241563"
    },
    {
      "path": "/js/pages/merch-buying.js",
      "gitBlobSha": "025ccb548a0a9af9238e511c84488c954c0a329b"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 1000,
  "journeys": [
    {
      "name": "fit-guidance-pdp",
      "captureSelector": ".merch-detail-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='womens-premium-tee'] [data-open-product]", "label": "Open women's premium tee"},
        {"action": "click", "selector": "[data-detail-size='L']", "label": "Choose L"}
      ]
    },
    {
      "name": "shipping-returns-pdp",
      "captureSelector": ".merch-detail-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-hoodie'] [data-open-product]", "label": "Open men's hoodie"},
        {"action": "click", "selector": "[data-detail-size='XL']", "label": "Choose XL"}
      ]
    },
    {
      "name": "bag-no-surprises",
      "captureSelector": ".merch-cart-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-tee'] [data-open-product]", "label": "Open premium tee"},
        {"action": "click", "selector": "[data-detail-size='M']", "label": "Choose M"},
        {"action": "click", "selector": "[data-checkout-button]", "label": "Add to bag"}
      ]
    },
    {
      "name": "size-filter",
      "captureSelector": ".merch-catalog",
      "steps": [
        {"action": "click", "selector": "[data-size-filter='5XL']", "label": "Filter 5XL"},
        {"action": "click", "selector": "[data-reset-filters]", "label": "Reset filters"}
      ]
    }
  ]
}
