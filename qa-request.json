{
  "requestId": "merch-13-product-details-final-20261002",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-catalog",
  "deploymentProbes": [
    {
      "path": "/css/pages/merch.css",
      "gitBlobSha": "0bbe8f8260b61aaab19f8f13ef8daa31e6711901"
    },
    {
      "path": "/js/pages/merch.js",
      "gitBlobSha": "cb3c50586c9e40473be82eaebc12c4fdec4c6af1"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": false,
  "waitMs": 500,
  "journeys": [
    {
      "name": "mens-tee-customize",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"mens-premium-tee\"] [data-quick-wordmark=\"blanka\"]",
          "label": "Men tee Blanka"
        },
        {
          "action": "click",
          "selector": "[data-product-id=\"mens-premium-tee\"] [data-quick-print=\"white\"]",
          "label": "Men tee white print"
        },
        {
          "action": "select",
          "selector": "[data-product-id=\"mens-premium-tee\"] [data-quick-size]",
          "value": "XL",
          "label": "Men tee XL"
        },
        {
          "action": "click",
          "selector": "[data-product-id=\"mens-premium-tee\"] [data-open-product]",
          "label": "Open men tee"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close men tee"
        }
      ]
    },
    {
      "name": "womens-hoodie-detail",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"womens-premium-hoodie\"] [data-open-product]",
          "label": "Open women hoodie"
        },
        {
          "action": "click",
          "selector": "[data-detail-size=\"2XL\"]",
          "label": "Women hoodie 2XL"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close women hoodie"
        }
      ]
    },
    {
      "name": "unisex-side-pocket-detail",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"unisex-side-pocket-hoodie\"] [data-open-product]",
          "label": "Open unisex side pocket hoodie"
        },
        {
          "action": "click",
          "selector": "[data-detail-wordmark=\"blanka\"]",
          "label": "Unisex Blanka"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close unisex hoodie"
        }
      ]
    },
    {
      "name": "contrast-multiview",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"contrast-hoodie\"] [data-open-product]",
          "label": "Open contrast hoodie"
        },
        {
          "action": "click",
          "selector": "[data-detail-view=\"back\"]",
          "label": "Contrast hoodie back"
        },
        {
          "action": "click",
          "selector": "[data-detail-view=\"front\"]",
          "label": "Contrast hoodie front"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close contrast hoodie"
        }
      ]
    },
    {
      "name": "trucker-detail",
      "steps": [
        {
          "action": "click",
          "selector": "[data-product-id=\"trucker-hat\"] [data-open-product]",
          "label": "Open trucker hat"
        },
        {
          "action": "click",
          "selector": "[data-dialog-close]",
          "label": "Close trucker hat"
        }
      ]
    }
  ]
