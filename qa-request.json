{
  "requestId": "merch-variant-buying-flow-20261006",
  "target": "hipdiscovery",
  "path": "/merch",
  "selector": ".merch-shop-head",
  "deploymentProbes": [
    {
      "path": "/js/pages/merch-buying.js",
      "gitBlobSha": "8ba5f06f02308b7840975b8d1b8fc0288147b657"
    },
    {
      "path": "/js/pages/merch-experience.js",
      "gitBlobSha": "a7edead83ce438b00cbf0878f5eb30c6cf6a8e8c"
    },
    {
      "path": "/css/pages/merch-experience.css",
      "gitBlobSha": "667739f46fb554ee4e9a17e3ebcdb5f56e78d39d"
    }
  ],
  "viewports": [
    "desktop-owner",
    "desktop-compact",
    "tablet",
    "mobile-large",
    "mobile",
    "mobile-small"
  ],
  "fullPage": true,
  "waitMs": 2600,
  "journeys": [
    {
      "name": "hero-next-look",
      "captureSelector": ".merch-shop-head",
      "steps": [
        {"action": "click", "selector": "[data-hero-next]", "label": "Show next featured look"}
      ]
    },
    {
      "name": "catalog-variant-discovery",
      "captureSelector": ".merch-catalog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-tee'] [data-open-product]", "label": "Open premium tee"},
        {"action": "click", "selector": "[data-dialog-close]", "label": "Return to collection"}
      ]
    },
    {
      "name": "fit-guidance-pdp",
      "captureSelector": ".merch-detail-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='womens-premium-tee'] [data-open-product]", "label": "Open women's premium tee"},
        {"action": "click", "selector": "[data-detail-size='L']", "label": "Choose L"}
      ]
    },
    {
      "name": "bag-buying-flow",
      "captureSelector": ".merch-cart-dialog",
      "steps": [
        {"action": "click", "selector": ".merch-card[data-product-id='mens-premium-hoodie'] [data-open-product]", "label": "Open men's hoodie"},
        {"action": "click", "selector": "[data-detail-size='L']", "label": "Choose L"},
        {"action": "click", "selector": "[data-checkout-button]", "label": "Add to bag"}
      ]
    }
  ]
}
